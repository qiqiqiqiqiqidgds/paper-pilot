{
  "name": "paperpilot-desktop",
  "version": "1.0.0",
  "description": "PaperPilot 桌面版（Electron 壳：托管 PyInstaller 后端 + Next.js 静态前端）",
  "author": "PaperPilot Authors",
  "license": "MIT",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "assemble": "node scripts/assemble.mjs",
    "start": "electron .",
    "smoke": "electron . --smoke",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.paperpilot.desktop",
    "productName": "PaperPilot",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/backend",
        "to": "backend"
      },
      {
        "from": "resources/frontend",
        "to": "frontend"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "PaperPilot"
    }
  },
  "allowScripts": {
    "electron@44.4.3": true,
    "electron-winstaller@5.4.0": true
  }
}
