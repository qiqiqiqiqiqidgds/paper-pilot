# PaperPilot Backend 环境变量示例
# 复制本文件为 .env 并填入真实值：
#   cp .env.example .env   (Linux/Mac)
#   copy .env.example .env (Windows)
#
# 💡 提示：LLM / 搜索供应商也可以不配 .env，启动应用后在网页右上角「设置」
#    界面里填写（保存到 data/settings.json，即时生效）。.env 里的值作为兜底默认。

# ============ LLM（OpenAI 兼容协议,支持多家）============
# 后端用 openai SDK 调任何 OpenAI 兼容的 chat.completions 端点。
# 常见选择:MiniMax / DeepSeek / OpenAI / 自建网关（Ollama、vLLM 等）。

# ---- 选项 A：MiniMax 国内平台（Token Plan 订阅 Key / pay-as-you-go 都可）----
# 注册: https://platform.minimaxi.com/
# 订阅 Key 形如 sk-cp-*,pay-as-you-go Key 形如 sk-*(无 cp)
# 国内 base_url: https://api.minimaxi.com/v1
# 海外 base_url: https://api.minimax.io/v1
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_MODEL=MiniMax-M3

# ---- 选项 B：DeepSeek（兼容 OpenAI SDK,作为 fallback）----
# DEEPSEEK_API_KEY=sk-your-deepseek-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# （⚠️ 旧版变量名仍兼容,但推荐统一用 LLM_*）

# ---- 推理 / 输出控制 ----
# 传给模型的 extra_body.reasoning_split(MiniMax M2/M3 实际不生效,
# 后端 chat_json() 会用 _strip_think_tags 兜底剥离 <think> 标签)。
# 留空=不传。
LLM_REASONING_SPLIT=true

# OpenAI o1 专属参数。MiniMax / DeepSeek 都不支持,留空=不传。
# ⚠️ 不要乱填,即使 OpenAI SDK 1.x 签名里有该参数,透传给 MiniMax
# 也只是被静默忽略(不会报错)。留空最稳。
LLM_REASONING_EFFORT=

# 单次 chat 最大输出 tokens。MiniMax-M3 支持更高,论文分析建议 ≥ 8000。
# 不设/留空=用代码默认(chat=4000, chat_json=4000),长论文 Map 阶段可能截断。
LLM_MAX_TOKENS=8000

# LLM 阶段整体超时（秒）。Map 超时的章节按该章失败处理,不整体崩溃;Reduce/整篇分析超时返回 502
LLM_TIMEOUT_SECONDS=300
# 单次 LLM HTTP 请求超时（秒）。SDK 层超时,与上面的整体超时是两层;
# 含重试最坏可达 4×该值,超过 LLM_TIMEOUT_SECONDS 时由整体超时兜底
LLM_REQUEST_TIMEOUT_SECONDS=120

# P3-5: breakdown Map 阶段最大并发 LLM 调用数（默认 3）。
# 容易撞 provider 并发/Token Plan 限流时可调小为 1-2;多人共用时可保持默认。
LLM_MAP_CONCURRENCY=3

# ============ 联网搜索 ============
# 供应商选择：
#   arxiv  —— 默认方案,免费无需 key,学术论文搜索（arXiv 官方 API）,
#             与论文伴读场景最匹配;按 arXiv 礼貌政策自动限速（3s/请求）
#   tavily —— 通用网页搜索,需下面 TAVILY_API_KEY
SEARCH_PROVIDER=arxiv

# Tavily（仅当 SEARCH_PROVIDER=tavily 时需要）
# 注册地址:https://tavily.com/
# 免费额度:每月 1000 次
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
# Tavily 单次请求超时（秒）。搜索慢时可调大,默认 60
TAVILY_TIMEOUT_SECONDS=60

# ============ 应用配置 ============
# 运行环境：dev（开发） / staging（预发） / prod（生产）
# ⚠️ prod 模式会强制要求 APP_API_KEY：
#   · 启动期 RuntimeError 阻断（main.py）
#   · 若 APP_HOST=0.0.0.0 且未配 APP_API_KEY,config 层直接 ValueError 拒绝启动（防裸奔）
# ⚠️⚠️ 注意：APP_ENV 默认是 dev。dev 下"0.0.0.0 + 无 APP_API_KEY"是允许启动的
#（仅打启动警告）—— 要让上面的 prod 防线生效，必须显式设置 APP_ENV=prod。
# dev 模式同时监听 0.0.0.0 意味着局域网内任何设备都能访问并消耗你的 LLM token。
APP_ENV=dev
# 监听地址。本地开发用 0.0.0.0;生产建议改为内网 IP 或 127.0.0.1（由反代对外暴露）,
# 不要在生产裸监听 0.0.0.0（公网直连 + 无鉴权 = 被薅/被打）
# ⚠️ 仅本机开发请用 127.0.0.1（0.0.0.0 = 对整个局域网开放）
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
# 并发 worker 数。>1 会导致内存限流按进程数放大（详见 ratelimit.py）
# 生产建议保持 1（用反代层限流）,或用多机部署
APP_WORKERS=1
# 上传文件大小上限（字节）,默认 50MB = 52428800
MAX_UPLOAD_SIZE_BYTES=52428800

# 数据存储目录（相对路径）
DATA_DIR=./data

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# CORS（前端地址,多个用逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 反代白名单（X-Forwarded-For 信任的 upstream IP/域名,多个用逗号分隔）
# ⚠️ 生产部署反代时必填:只信任真正代理的 IP（如 127.0.0.1 / nginx 内网 IP）
# 非白名单 peer 的 X-Forwarded-For 会被忽略（防伪造）
# ⚠️⚠️ 安全警告:默认信任 127.0.0.1 仅为兼容常见单机反代场景。若反代暴露在公网且
# 客户端可直连,攻击者可伪造 X-Forwarded-For 绕过按 IP 限流。生产必须:
#   ① 把本项改成真实反代 IP;② 反代层丢弃/覆写客户端传入的 X-Forwarded-For
TRUSTED_HOSTS=127.0.0.1,localhost

# ============ 访问鉴权（部署前必填）============
# 留空 = 不鉴权（仅本地开发,部署出去会被薅）
# 生产部署（APP_ENV=prod）必须设置一个强随机串,例如:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=

# 客户端调用示例:
#   curl -H "X-API-Key: <your-key>" http://localhost:8000/api/papers
# 前端 fetch 方式:
#   fetch('http://localhost:8000/api/papers', { headers: { 'X-API-Key': '<your-key>' } })

# ============ 限流（按 IP,每分钟）============
# 通用接口:60/min
RATE_LIMIT_GENERAL_PER_MIN=60
# 昂贵接口（/api/analyze, /api/generate-ppt, /api/compare*, /api/search-related, /api/upload）:10/min
# ⚠️ MiniMax Token Plan 有 5h 窗口限流,单次论文分析会并发 5+ 章节调用,
# 如果同时多人使用容易撞 Token Plan 窗口。可调到 5/min 配合。
RATE_LIMIT_EXPENSIVE_PER_MIN=10

# 超限响应示例:
#   HTTP/1.1 429 Too Many Requests
#   Retry-After: 23
#   {"code":429, "message":"请求过于频繁（expensive 接口 10/min）..."}
